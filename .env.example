
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_URL=

MAX_ENABLED=false
MAX_TOKEN=
MAX_TIMEOUT_SECONDS=30
MAX_WEBHOOK_URL=https://handbookbot.example.com/max/webhook

# ─── Источник данных ────────────────────────────────────────────────────────
# Режим: api | inmemory (по умолчанию) | database (временно отключено)
DATA_SOURCE=api

# ─── RefInfoAPI (обязательно при DATA_SOURCE=api) ───────────────────────────
# Базовый URL RefInfoAPI
REFINFOAPI__BASEURL=https://ref-info-api.example.com

# Логин и пароль пользователя (используются для получения JWT через POST /auth/login)
REFINFOAPI__USERNAME=bot_user
REFINFOAPI__PASSWORD=your_password_here

# Устаревшие переменные (оставлены для обратной совместимости)
# DATA_API_BASE_URL=https://api.example.com
