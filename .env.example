
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_URL=

MAX_ENABLED=false
MAX_TOKEN=
MAX_TIMEOUT_SECONDS=30
MAX_WEBHOOK_URL=https://handbookbot.example.com/max/webhook

# ─── BotEngine (Rate Limiting) ───────────────────────────────────────────────
RATE_LIMIT_MAX_MESSAGES=30
RATE_LIMIT_WINDOW_SECONDS=60


# ─── Источник данных ────────────────────────────────────────────────────────
# Режим: api (по умолчанию в Docker Compose) | inmemory | database (временно отключено)
DATA_SOURCE=api

# ─── RefInfoAPI ─────────────────────────────────────────────────────────────
# В Docker Compose бот подключается к API по внутренней сети: http://api:8080
# При локальном запуске без Docker: http://localhost:5131
REFINFOAPI__BASEURL=http://api:8011

# Логин и пароль пользователя (если API требует JWT через POST /auth/login)
REFINFOAPI__USERNAME=
REFINFOAPI__PASSWORD=

# Настройки БД для сервиса API (если запускается через docker-compose)
# При подключении к MS SQL на хосте: Server=host.docker.internal;Database=Registr;User Id=sa;Password=your_password;TrustServerCertificate=True;
# DB_CONNECTION_STRING=Server=host.docker.internal;Database=Registr;User Id=sa;Password=your_password;TrustServerCertificate=True;

# Кэш координат геокодера SQLite (в контейнере: /app/data/geocache.db, локально: geocache.db)
GEO_CACHE_CONNECTION_STRING=Data Source=/app/data/geocache.db

# ─── Яндекс Геокодер (для RefInfoAPI) ─────────────────────────────────────────
# Получить API-ключ: https://developer.tech.yandex.ru/services/
YANDEX_GEOCODER_API_KEY=
YANDEX_GEOCODER_BASE_URL=https://geocode-maps.yandex.ru/v1/
YANDEX_GEOCODER_CACHE_DURATION_MINUTES=1440

# ─── Настройки безопасности JWT (RefInfoAPI) ──────────────────────────────────
JWT_ISSUER=RefInfoAPI
JWT_AUDIENCE=RefInfoAPIClient
JWT_KEY=REPLACE_THIS_WITH_A_STRONG_SECRET_KEY_32CHARS_MIN

