
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_URL=

MAX_ENABLED=false
MAX_TOKEN=
MAX_TIMEOUT_SECONDS=30
MAX_WEBHOOK_URL=https://handbookbot.example.com/max/webhook

# ─── Источник данных ────────────────────────────────────────────────────────
# Режим: api (по умолчанию в Docker Compose) | inmemory | database (временно отключено)
DATA_SOURCE=api

# ─── RefInfoAPI ─────────────────────────────────────────────────────────────
# В Docker Compose бот подключается к API по внутренней сети: http://api:8080
# При локальном запуске без Docker: http://localhost:5131
REFINFOAPI__BASEURL=http://api:8080

# Логин и пароль пользователя (если API требует JWT через POST /auth/login)
REFINFOAPI__USERNAME=
REFINFOAPI__PASSWORD=

# Настройки БД для сервиса API (если запускается через docker-compose)
# DB_CONNECTION_STRING=Server=host.docker.internal;Database=Registr;User Id=sa;Password=your_password;TrustServerCertificate=True;

